generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== CORE CONFIG =====

model Channel {
  id              String   @id @default(cuid())
  name            String?
  niche           String?
  description     String?
  positioning     String?
  targetViewer    String?
  brandPromise    String?
  uploadCadence   String?
  visualIdentity  String?  // JSON
  bannerSpec      String?
  profileImageSpec String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OAuthConnection {
  id            String   @id @default(cuid())
  provider      String   @default("google")
  accessToken   String?
  refreshToken  String?  // encrypted at rest
  tokenExpiry   DateTime?
  scope         String?
  csrfState     String?
  channelId     String?
  channelTitle  String?
  isConnected   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== STRATEGY =====

model ContentPillar {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  icon        String?
  priority    Int      @default(0)
  videoIdeas  VideoIdea[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NicheAnalysis {
  id                  String   @id @default(cuid())
  nicheName           String
  searchDemand        Float    @default(0)
  audienceSize        Float    @default(0)
  competition         Float    @default(0)
  advertiserValue     Float    @default(0)
  sponsorshipPotential Float   @default(0)
  affiliatePotential  Float    @default(0)
  evergreenPotential  Float    @default(0)
  topicCapacity       Float    @default(0)  // can sustain 200+ topics
  productionDifficulty Float   @default(0)
  paidToolsNeeded     Float    @default(0)
  copyrightRisk       Float    @default(0)
  misinformationRisk  Float    @default(0)
  retentionPotential  Float    @default(0)
  longFormSuitability Float    @default(0)
  shortsSuitability   Float    @default(0)
  internationalPotential Float  @default(0)
  timeToMonetisation  Float    @default(0)
  revenuePerHour      Float    @default(0)
  compositeScore      Float    @default(0)
  isSelected          Boolean  @default(false)
  rejectionReason     String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ===== CONTENT PIPELINE =====

model VideoIdea {
  id              String   @id @default(cuid())
  title           String
  description     String?
  pillarId        String?
  type            String   @default("longform") // longform | short
  status          String   @default("idea")
  // idea → researched → scripted → producing → reviewing → approved → uploaded → published
  searchVolume    Int?
  competitionScore Float?
  originalityScore Float?
  retentionPrediction Float?
  revenuePotential Float?
  productionEffort Float?
  riskScore       Float?
  compositeScore  Float?
  tags            String?  // JSON array
  scheduledDate   DateTime?
  pillar          ContentPillar? @relation(fields: [pillarId], references: [id])
  researchSources ResearchSource[]
  claims          ClaimLedger[]
  scripts         Script[]
  videoProjects   VideoProject[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ResearchSource {
  id             String   @id @default(cuid())
  videoIdeaId    String
  title          String
  publisher      String?
  publicationDate String?
  accessDate     DateTime @default(now())
  sourceUrl      String?
  sourceLocation String?
  sourceType     String   @default("secondary") // primary | secondary | official | academic | publication
  isVerified     Boolean  @default(false)
  isTimeSensitive Boolean @default(false)
  lastCheckedAt  DateTime?
  notes          String?
  videoIdea      VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ClaimLedger {
  id            String   @id @default(cuid())
  videoIdeaId   String
  claim         String
  sourceIds     String   // JSON array of ResearchSource IDs
  isConflicting Boolean  @default(false)
  isUncertain   Boolean  @default(false)
  isRejected    Boolean  @default(false)
  conflictNotes String?
  videoIdea     VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Script {
  id               String   @id @default(cuid())
  videoIdeaId      String
  content          String
  outline          String?
  hook             String?
  callToAction     String?
  wordCount        Int      @default(0)
  estimatedMinutes Float?
  originalityScore Float?
  originalityReport String?  // JSON
  version          Int      @default(1)
  status           String   @default("draft") // draft → factchecked → reviewed → approved → rejected
  factCheckNotes   String?
  scenes           Scene[]
  voiceTracks      VoiceTrack[]
  videoIdea        VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Scene {
  id             String   @id @default(cuid())
  scriptId       String
  order          Int
  title          String
  description    String?
  duration       Float?   // seconds
  visualType     String   @default("text") // screenrecording | diagram | animation | chart | image | text | custom
  visualNotes    String?
  narrationText  String?
  transitionType String?
  script         Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== ASSETS & LICENSING =====

model Asset {
  id          String   @id @default(cuid())
  title       String
  type        String   // video | audio | image | font | music | graphic
  filePath    String?
  fileUrl     String?
  fileSize    Int?
  mimeType    String?
  width       Int?
  height      Int?
  duration    Float?
  source      String?
  isOriginal  Boolean  @default(false)
  licence     AssetLicence?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssetLicence {
  id                 String   @id @default(cuid())
  assetId            String   @unique
  licenceType        String   @default("custom") // publicdomain | cc0 | ccby | ccbysa | commercial | yt-audio-library | creator-music | custom
  creator            String?
  source             String?
  commercialUse      Boolean  @default(false)
  attributionRequired Boolean @default(false)
  attributionText    String?
  revenueShare       Boolean  @default(false)
  revenueSharePercent Float?
  receiptFile        String?
  downloadDate       DateTime?
  expiryDate         DateTime?
  notes              String?
  asset              Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ===== PRODUCTION =====

model VoiceTrack {
  id         String   @id @default(cuid())
  scriptId   String
  assetId    String?  // links to Asset for audio file
  voiceName  String?
  language   String   @default("en")
  speed      Float    @default(1.0)
  duration   Float?
  status     String   @default("pending") // pending → generating → completed → failed
  script     Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model VideoProject {
  id              String   @id @default(cuid())
  videoIdeaId     String
  title           String
  status          String   @default("planning")
  // planning → storyboarding → collecting_assets → recording → editing → rendering → review → approved → uploading → uploaded → failed
  videoFilePath   String?
  thumbnailPath   String?
  captionPath     String?
  resolution      String   @default("1080p")
  duration        Float?
  fileSize        Int?
  renderProgress  Float    @default(0)
  reviewResult    String?  // JSON with all check results
  isApproved      Boolean  @default(false)
  editorNotes     String?
  policyReviews   PolicyReview[]
  upload          Upload?
  videoIdea       VideoIdea @relation(fields: [videoIdeaId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Upload {
  id              String   @id @default(cuid())
  videoProjectId  String   @unique
  youtubeVideoId  String?
  title           String
  description     String?
  tags            String?  // JSON array
  category        String   @default("28") // Science & Technology
  privacy         String   @default("private") // private | unlisted | public
  language        String   @default("en")
  madeForKids     Boolean  @default(false)
  isAiGenerated   Boolean  @default(true)
  aiDisclosureText String?
  uploadStatus    String   @default("pending") // pending → uploading → completed → failed → processing
  processingStatus String? // YouTube processing status
  publishedAt     DateTime?
  analytics       AnalyticsSnapshot[]
  videoProject    VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PublicationSchedule {
  id          String   @id @default(cuid())
  uploadId    String?
  scheduledAt DateTime
  status      String   @default("pending") // pending → published → cancelled → failed
  timezone    String   @default("UTC")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== ANALYTICS =====

model AnalyticsSnapshot {
  id                    String   @id @default(cuid())
  uploadId              String
  snapshotDate          DateTime @default(now())
  views                 Int      @default(0)
  impressions           Int      @default(0)
  clickThroughRate      Float    @default(0)
  averageViewDuration   Float    @default(0)
  averagePercentageViewed Float  @default(0)
  subscribersGained     Int      @default(0)
  likes                 Int      @default(0)
  comments              Int      @default(0)
  shares                Int      @default(0)
  estimatedRevenue      Float    @default(0)
  rpm                   Float    @default(0)
  cpm                   Float    @default(0)
  trafficSources        String?  // JSON
  audienceRetention     String?  // JSON
  searchTerms           String?  // JSON
  upload                Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ===== REVENUE =====

model RevenueRecord {
  id          String   @id @default(cuid())
  type        String   // ad_revenue | premium | super_thanks | membership | sponsorship | affiliate | merchandise | other
  source      String
  amount      Float
  currency    String   @default("USD")
  date        DateTime
  uploadId    String?
  description String?
  isEstimated Boolean  @default(true)
  isFinalized Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== OPPORTUNITIES =====

model AffiliateOffer {
  id                  String   @id @default(cuid())
  name                String
  provider            String
  description         String?
  eligibility         String?
  countryAvailability String?
  minAge              Int?
  guardianRequired    Boolean  @default(false)
  paymentMethod       String?
  requiredDisclosures String?
  revenueSharePercent Float?
  url                 String?
  status              String   @default("discovered") // discovered → evaluating → approved → active → rejected
  riskLevel           String   @default("medium") // low | medium | high
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Sponsorship {
  id                  String   @id @default(cuid())
  brandName           String
  contactEmail        String?
  description         String
  deliverables        String?
  compensation        String?
  contractFile        String?
  requiredDisclosures String?
  status              String   @default("outreach") // outreach → negotiating → agreed → active → completed → rejected
  riskLevel           String   @default("medium")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ===== QUALITY & POLICY =====

model PolicyReview {
  id              String   @id @default(cuid())
  videoProjectId  String
  videoProject    VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  factCheckPassed Boolean  @default(false)
  originalityPassed Boolean @default(false)
  copyrightPassed Boolean  @default(false)
  advertiserFriendly Boolean @default(false)
  aiDisclosureSet Boolean  @default(false)
  thumbnailAccurate Boolean @default(false)
  titleAccurate   Boolean  @default(false)
  audioQualityOk  Boolean  @default(false)
  videoQualityOk  Boolean  @default(false)
  captionsAccurate Boolean @default(false)
  noDeceptiveContent Boolean @default(false)
  overallPassed   Boolean  @default(false)
  issues          String?  // JSON array of issues found
  reviewedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== EXPERIMENTS =====

model Experiment {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          String   // thumbnail | title | description | upload_time | format
  hypothesis    String?
  variableTested String?
  status        String   @default("planning") // planning → running → completed → cancelled
  startDate     DateTime?
  endDate       DateTime?
  result        String?
  recommendation String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== JOB QUEUE (persistent scheduler) =====

model Job {
  id          String   @id @default(cuid())
  type        String   // niche_research | topic_research | script_write | produce_video | quality_review | upload | publish | analytics_collect | strategy_review | revenue_review | token_refresh
  status      String   @default("pending") // pending → running → completed → failed → cancelled
  priority    Int      @default(5)
  data        String?  // JSON payload for the job
  result      String?  // JSON result after completion
  error       String?
  scheduledAt DateTime
  startedAt   DateTime?
  completedAt DateTime?
  retryCount  Int      @default(0)
  maxRetries  Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== AUDIT LOG =====

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // upload | publish | metadata_update | token_refresh | token_revoke | strategy_change | emergency_stop | mode_change
  actor     String   @default("agent") // agent | owner | system
  target    String?  // what was affected
  details   String?  // JSON
  createdAt DateTime @default(now())
}

// ===== AGENT STATE =====

model AgentState {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String   // JSON
  updatedAt     DateTime @updatedAt
}

// ===== NOTIFICATIONS =====

model Notification {
  id          String   @id @default(cuid())
  type        String   // "success" | "error" | "warning" | "info" | "agent_event"
  category    String   // "agent" | "pipeline" | "revenue" | "system" | "youtube"
  title       String
  description String?
  targetId    String?  // optional: related entity ID (videoProjectId, uploadId, etc)
  targetType  String?  // optional: "video_project" | "upload" | "idea" | "job"
  isRead      Boolean  @default(false)
  isImportant Boolean  @default(false)
  actionLabel String?  // optional: button label
  actionTab   String?  // optional: tab to navigate to (overview, pipeline, etc)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
  @@index([category])
}

// ===== YPP PROGRESS =====

model YPPProgress {
  id                  String   @id @default(cuid())
  subscribers         Int      @default(0)
  publicUploads       Int      @default(0)
  watchHours          Float    @default(0)
  shortsViews         Float    @default(0)
  communityStrikes    Int      @default(0)
  twoStepVerified     Boolean  @default(false)
  advancedFeatures    Boolean  @default(false)
  adsenseLinked       Boolean  @default(false)
  lastCheckedAt       DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
