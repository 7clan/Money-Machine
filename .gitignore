# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# === SECRETS — NEVER COMMIT ===
.env
.env.local
.env.production
.env.development
.env.staging
# Explicitly track .env.example (template) and .env.template
!.env.example
!.env.template

# OAuth tokens / credentials (any file containing refresh tokens / access tokens / client secrets)
**/tokens.json
**/youtube-tokens.json
**/credentials.json
**/client_secret*.json
**/service-account*.json
*.token

# Database (contains OAuth refresh tokens at runtime)
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt
server.log

# Skills directory
/skills/

# === GENERATED MEDIA — too large for git, not source code ===
# Videos, audio, images, contact sheets, thumbnails generated by productions
data/videos/
data/audio/
data/images/
data/assets/
data/contact-sheets/
data/qc-frames/
data/thumbnails/
data/zai-cache/
data/remotion-props/
data/regression/
data/benchmark/
data/autonomous-runs/*/renders/
data/autonomous-runs/*/renders-pre-repair/
data/pipeline-state/*.mp4
data/pipeline-state/*.mp3
data/pipeline-state/*.wav

# Remotion render chunks + cached frames
data/videos/chunks*/
public/cycle-*/
public/remotion-assets/
public/test-d/
public/devtools-captures/

# Agent runtime scratch (logs, tmp)
data/autonomous-runs/*/logs/*.log
data/autonomous-runs/*/subagent-chain/*/tmp/
data/autonomous-runs/*/subagent-chain/*/stdout.log
data/autonomous-runs/*/subagent-chain/*/stderr.log
agent-ctx/*.md
download/
upload/
home/

# Bundler / renderer caches
.cache/
.remotion/
.eslintcache

# TTS audio cache + image cache
**/audio/*.mp3
**/audio/*.wav
**/audio/*.hash
data/media-store/
data/artifacts/*
!data/artifacts/artifact-manifest.json
