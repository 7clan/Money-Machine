# MONEY MACHINE — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it's gitignored).

# Database (SQLite — local file, contains OAuth tokens at runtime, gitignored)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# YouTube OAuth credentials (from Google Cloud Console → APIs & Services → Credentials)
# Create an OAuth 2.0 Client ID of type "Web application"
# Authorized redirect URI must be: http://localhost:3000/api/youtube/callback
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Scopes requested at OAuth time (space-separated):
#   https://www.googleapis.com/auth/youtube.upload       (upload videos)
#   https://www.googleapis.com/auth/youtube.readonly     (read video metadata)
#   https://www.googleapis.com/auth/yt-analytics.readonly (read analytics — requires user consent)
#
# The yt-analytics.readonly scope is requested but the user must explicitly grant it.
# After reconnect-analytics, the granted scope is verified to contain yt-analytics.readonly.
